<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The Tanoshi server binds a local socket (and, when the user enables
         LAN mode, 0.0.0.0) and fetches online manga sources. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Persistent foreground server process. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The server service also declares the mediaPlayback type and plays an
         inaudible generated silence loop while the server runs: this keeps the
         app in a media-playback foreground-service state so the OS/OEM is less
         likely to kill it and its native server child processes. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- In-app updates: download the latest APK from this repo's GitHub
         releases and hand it to the PackageInstaller. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".TanoshiApp"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tanoshi">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          foregroundServiceType="specialUse|mediaPlayback":
          - specialUse fits a self-hosted application server; dataSync would be
            capped at 6 hours per day on Android 15+, which would stop a
            long-running server.
          - mediaPlayback is used together with an inaudible, zero-volume
            generated silence loop while the server runs. Keeping the app in a
            media-playback foreground-service state makes Android/OEMs much less
            likely to kill it (and its native server child processes) on devices
            where the Android 12+ phantom-process killer or OEM child-process
            restrictions are active. It is a best-effort mitigation only.
        -->
        <service
            android:name=".server.TanhoshiService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaPlayback"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Self-hosted local manga server; keeps the bundled Tanoshi server process alive until the user stops it." />
        </service>

    </application>

</manifest>
