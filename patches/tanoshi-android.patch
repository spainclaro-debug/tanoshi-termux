+                        info!(
+                            "using {name} built from source after download failed: {download_error}"
+                        );
+                        tokio::fs::read(&built).await?.into()
+                    }
+                    Ok(None) => return Err(download_error),
+                    Err(build_error) => {
+                        return Err(anyhow!(
+                            "{download_error}; building {name} from source also failed: {build_error}"
+                        ));
+                    }
+                }
+            }
+        };
         let plugin_path = self.dir.join(&plugin_name).with_extension(PLUGIN_EXTENSION);
         let temporary_path = self.unique_managed_path(&plugin_path, INSTALL_TEMP_PREFIX)?;
 
