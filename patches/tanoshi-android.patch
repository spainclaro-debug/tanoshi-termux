+/// Build a `reqwest` client with a TLS backend that works on this platform.
+///
+/// Android/Termux cannot use `rustls-platform-verifier` (it needs the Android
+/// Java runtime to load the system trust store, and panics otherwise), so
+/// Android falls back to the bundled Mozilla (webpki) roots. Other platforms
+/// keep reqwest's default backend.
+pub(crate) fn http_client() -> reqwest::Client {
+    #[cfg(not(target_os = "android"))]
+    let builder = reqwest::Client::builder();
+
+    #[cfg(target_os = "android")]
+    let builder = {
+        let mut roots = rustls::RootCertStore::empty();
+        roots.extend(webpki_roots::TLS_SERVER_ROOTS.iter().cloned());
+        let config = rustls::ClientConfig::builder()
+            .with_root_certificates(roots)
+            .with_no_client_auth();
+        reqwest::Client::builder().tls_backend_preconfigured(config)
+    };
+
+    builder.build().unwrap_or_default()
+}
