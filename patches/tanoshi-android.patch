+        let download = async {
+            let response = crate::http_client()?.get(&source_file_url).send().await?;
+            let status = response.status();
+            let bytes = response.bytes().await?;
+            // A missing platform directory comes back as 404 with a short text
+            // body that would otherwise be written out as a "plugin".
+            if !status.is_success() {
+                bail!("download returned HTTP {status}");
+            }
+            if bytes.len() < MIN_PLUGIN_BYTES {
+                bail!("download returned {} bytes, too small to be a plugin", bytes.len());
+            }
