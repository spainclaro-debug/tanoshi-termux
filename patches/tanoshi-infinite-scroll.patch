+    /// Load the next page when the sentinel nears the viewport.
+    fn maybe_autoload(catalogue: Rc<Self>) {
+        // Never stack requests, and stop at the end of the listing.
+        if catalogue.spinner.active.get() || !catalogue.has_more.get() {
+            return;
+        }
+        // The very first page is fetched by render(); nothing to append yet.
+        if catalogue.cover_list.lock_ref().is_empty() {
+            return;
+        }
+
+        catalogue.page.set(catalogue.page.get() + 1);
+        Self::fetch_mangas(catalogue.clone());
+
+        // A short page may leave the sentinel inside the viewport, and
+        // IntersectionObserver only reports crossings. Nudge it to re-evaluate.
+        let weak_catalogue = Rc::downgrade(&catalogue);
+        Timeout::new(1200, move || {
+            if let Some(catalogue) = weak_catalogue.upgrade() {
+                Self::recheck_scroll_sentinel(&catalogue);
+            }
+        })
+        .forget();
+    }
+
+    fn recheck_scroll_sentinel(catalogue: &Rc<Self>) {
+        let observer = catalogue.scroll_observer.borrow();
+        let sentinel = catalogue.scroll_sentinel.borrow();
+        if let (Some(observer), Some(sentinel)) = (observer.as_ref(), sentinel.as_ref()) {
+            observer.unobserve(sentinel);
+            observer.observe(sentinel);
+        }
+    }
+
+    fn observe_scroll_sentinel(catalogue: Rc<Self>, sentinel: web_sys::HtmlElement) {
+        if let Some(observer) = catalogue.scroll_observer.borrow_mut().take() {
+            observer.disconnect();
+        }
+        catalogue.scroll_observer_callback.borrow_mut().take();
+
+        let weak_catalogue = Rc::downgrade(&catalogue);
+        let callback = Closure::wrap(Box::new(
+            move |entries: js_sys::Array, _observer: IntersectionObserver| {
+                let is_intersecting = entries.iter().any(|entry| {
+                    entry
+                        .dyn_into::<IntersectionObserverEntry>()
+                        .ok()
+                        .is_some_and(|entry| entry.is_intersecting())
+                });
+
+                if is_intersecting
+                    && let Some(catalogue) = weak_catalogue.upgrade()
+                {
+                    Self::maybe_autoload(catalogue);
+                }
+            },
+        ) as Box<dyn FnMut(js_sys::Array, IntersectionObserver)>);
+
+        // Start loading 600px early so the next page is usually ready by the
+        // time the user reaches the bottom.
+        let options = web_sys::IntersectionObserverInit::new();
+        options.set_root_margin("600px");
+
+        let observer = IntersectionObserver::new_with_options(
+            callback.as_ref().unchecked_ref(),
+            &options,
+        )
+        .or_else(|_| IntersectionObserver::new(callback.as_ref().unchecked_ref()));
+
+        let observer = match observer {
+            Ok(observer) => observer,
+            Err(error) => {
+                warn!("failed to observe catalogue scroll sentinel: {error:?}");
+                return;
+            }
+        };
+
+        observer.observe(sentinel.unchecked_ref());
+        *catalogue.scroll_observer_callback.borrow_mut() = Some(callback);
+        *catalogue.scroll_observer.borrow_mut() = Some(observer);
+        *catalogue.scroll_sentinel.borrow_mut() = Some(sentinel);
+    }
