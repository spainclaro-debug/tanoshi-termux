+    /// Perform a throttled POST with a JSON body and decode a JSON response.
+    ///
+    /// `execute` is typed for bodyless GET requests, so this duplicates its
+    /// retry shape for the POST case.
+    pub fn fetch_json_post<T: DeserializeOwned>(&self, url: &str, body: &str) -> Result<T> {
+        if let Some(error) = self.configuration_error {
+            log::error!("RateLimitedAgent: {error}");
+            return Err(anyhow!(error));
+        }
+        let operation = Operation::new(self.limiter.clone());
+        loop {
+            operation.before_attempt()?;
+            debug!("POST {url}");
+            let mut response = self
+                .inner
+                .post(url)
+                .header("Content-Type", "application/json")
+                .config()
+                .http_status_as_error(false)
+                .timeout_global(Some(operation.request_timeout()?))
+                .build()
+                .send(body)?;
+
+            let status = response.status().as_u16();
+            if status == 429 {
+                let delay = crate::backoff::retry_after(response.headers());
+                drop(response);
+                operation.backoff(delay)?;
+                continue;
+            }
+            if status >= 400 {
+                return Err(ureq::Error::StatusCode(status).into());
+            }
+
+            let decoded = response.body_mut().read_json()?;
+            operation.remaining()?;
+            return Ok(decoded);
+        }
+    }
